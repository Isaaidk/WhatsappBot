# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v26.0
ORDER_NOTIFICATION_PHONE=

# Auto responder (respaldo cuando la IA no está disponible)
AUTO_REPLY_ENABLED=true
AUTO_REPLY_TEXT=¡Hola! Gracias por escribir a KITCHAN. Recibimos tu mensaje y pronto te atenderemos.

# IA (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
BUSINESS_NAME=Vangalia by Sweet Center

# Menú y stock en Google Sheets
GOOGLE_SHEET_ID=1lF3k8HNyf5nhSKbZaeZqFihyGHHegpj5Pqs7AOUPlqw
# Ruta al JSON de la cuenta de servicio (la hoja debe estar compartida con su email como Editor)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
SHEET_CACHE_SECONDS=60

# Local development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/whatsapp.db
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
